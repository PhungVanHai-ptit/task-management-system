# =======================================================
# File cấu hình mẫu biến môi trường (Environment Variables)
# =======================================================

# Cấu hình Mail SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# Cấu hình JWT
JWT_SECRET=mini-jira-intern-super-secret-key-must-be-at-least-256bits-long
JWT_EXPIRATION_MS=86400000
